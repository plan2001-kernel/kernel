    "werrstr": "preserved; formatted text is installed through the same swap",
    "success_path": "does not raise, allocate an OID or Handle, or depend on Handle-table capacity",
    "error_paths": "length 0 or >ERRMAX is Ebadarg; an invalid user address is rejected by generrstr's validaddr",
    "legacy": "ERRSTR(41) and _ERRSTR(1) remain active in the kernel dispatch table"
  },
