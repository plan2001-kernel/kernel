  "contract": {
    "opcode": 29,
    "opcode_name": "ObjOpErrstrExchange",
    "handle": "0 only; opens, looks up and consumes no Handle",
    "buffer": "c.out is the single IN/OUT user buffer; c.outlen in [1,ERRMAX]",
    "reserved": "c.in==NULL, c.inlen==0, c.arg0==0, c.arg1==0, flags/rights/reserved==0",
    "kernel_implementation": "the original generrstr() behind ERRSTR(41)/_ERRSTR(1), reused unchanged",
    "semantics": "validate the user address; copy the caller's new text into the previous error area; return the current error text in out; exchange up->errstr/up->syserrstr; return 0",
