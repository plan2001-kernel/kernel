    "PLAN2001_SYSCALL_TRACE=1 tools/build-mpy-gcc.sh -j 8",
    "tools/qemu-o-boot.sh --no-build --output-dir build/syscall-t4b/trace --timeout 360 --obootexec 0x4f45584543000003 --repl-input build/syscall-t4b/inputs/repl-t4b-trace.py --expect \"T4B-TRACE-DONE\"",
    "tools/build-gcc.sh --kernel -j 8",
    "tools/build-mpy-gcc.sh -j 8"
  ]
}
