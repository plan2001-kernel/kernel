--- a/runtime/abi/obj.h
+++ b/runtime/abi/obj.h
@@ -36,6 +36,8 @@ enum {
 	ObjOpenKbd		= 11,	/* privileged exclusive PS/2 claim */
 	ObjOpenUsb		= 12,	/* USB service: device/endpoint metadata */
