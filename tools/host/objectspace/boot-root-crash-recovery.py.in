# After an unpublished graph write and abrupt power loss, the committed root
# is restored unchanged. No substitute or partial root may be installed.
import plan9 as p

roots = p.space_roots()
assert len(roots) == 1
root = roots[0]
rows, _, _ = p.space_list(root)
replacedid = 0
for r in rows:
    bid, label, kind, rights, relation, identity, flags = r
    if label == 'replaced':
        replacedid = bid
    elif label == 'leaf':
        raise AssertionError('uncommitted root edge installed')
assert replacedid != 0
h = p.space_resolve(root, replacedid, p.VREAD)
assert p.obj_read(h, 13) == b'replaced-data'
print('BOOT-ROOT-CRASH-RECOVERY-PASS')
