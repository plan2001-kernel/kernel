server {
 server_name plan2001.com;
 location /.well-known/acme-challenge/ { root /var/www/html; }
 root /var/www/plan2001;
 index index.html;
 location = /.well-known/oauth-protected-resource { proxy_pass http://127.0.0.1:8765; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; }
 location = /.well-known/oauth-authorization-server { proxy_pass http://127.0.0.1:8765; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; }
 location ^~ /oauth/ { proxy_pass http://127.0.0.1:8765; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; proxy_buffering off; }
 location = /mcp { proxy_pass http://127.0.0.1:8765/mcp; proxy_http_version 1.1; proxy_buffering off; proxy_read_timeout 360s; proxy_set_header Host $host; }
 location = /agent-mcp { proxy_pass http://127.0.0.1:8765/agent-mcp; proxy_http_version 1.1; proxy_buffering off; proxy_read_timeout 360s; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; }
 location / { try_files $uri $uri/ =404; }

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/plan2001.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/plan2001.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = plan2001.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


 listen 80;
 listen [::]:80;
 server_name plan2001.com;
    return 404; # managed by Certbot


}